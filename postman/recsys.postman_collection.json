      "name": "4. Admin",
      "item": [
        {
          "name": "Reload with the right token (or no token when none is set)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "{{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/reload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "reload"
              ],
              "query": []
            },
            "description": "Builds the model again from models/champion and swaps it in. If ADMIN_TOKEN is set in .env, put the same value in the admin_token variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"reports previous and current model version\", () => pm.expect(b).to.have.all.keys(\"previous_version\", \"model_version\"));",
                  "pm.sendRequest(pm.variables.replaceIn(\"{{base_url}}/health\"), (err, res) => {",
                  "  pm.test(\"same model is loaded again (nothing was changed)\", () => {",
                  "    pm.expect(err).to.equal(null);",
                  "    pm.expect(b.model_version).to.equal(res.json().model_version);",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Reload with a wrong token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Admin-Token",
                "value": "wrong-token"
              }
            ],
            "url": {
              "raw": "{{base_url}}/admin/reload",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "admin",
                "reload"
              ],
              "query": []
            },
            "description": "Only rejected when ADMIN_TOKEN is set in .env; with no token configured the endpoint is open."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const tokenIsSet = !!(pm.environment.get(\"admin_token\") || pm.collectionVariables.get(\"admin_token\"));",
                  "pm.test(tokenIsSet ? \"403 because the token is wrong\" : \"200 because no ADMIN_TOKEN is configured (nothing to check)\", () => {",
                  "  pm.response.to.have.status(tokenIsSet ? 403 : 200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Recommendations still work after the reload",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/recommend?user_id={{known_user}}&k=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "recommend"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{known_user}}"
                },
                {
                  "key": "k",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has items, model_version, source, retrieval, degraded\", () => {",
                  "  pm.expect(body).to.have.all.keys(\"items\", \"model_version\", \"source\", \"retrieval\", \"degraded\");",
                  "});",
                  "pm.test(\"returns exactly 10 items\", () => pm.expect(body.items).to.have.lengthOf(10));",
                  "pm.test(\"every item has an integer item_id and a numeric score\", () => {",
                  "  body.items.forEach(i => { pm.expect(Number.isInteger(i.item_id)).to.be.true; pm.expect(i.score).to.be.a(\"number\"); });",
                  "});",
                  "pm.test(\"scores are sorted from best to worst\", () => {",
                  "  const s = body.items.map(i => i.score);",
                  "  for (let n = 1; n < s.length; n++) pm.expect(s[n - 1]).to.be.at.least(s[n]);",
                  "});",
                  "pm.test(\"no item is repeated\", () => {",
                  "  const ids = body.items.map(i => i.item_id);",
                  "  pm.expect(new Set(ids).size).to.equal(ids.length);",
                  "});",
                  "pm.test(\"source is ranker and Redis was reachable (not degraded)\", () => {",
                  "  pm.expect(body.source).to.equal(\"ranker\"); pm.expect(body.degraded).to.equal(false);",
                  "});",
                  "pm.test(\"X-Model-Version header equals model_version in the body\", () => {",
                  "  pm.expect(pm.response.headers.get(\"X-Model-Version\")).to.equal(body.model_version);",
                  "});",
                  "pm.test(\"candidates came from als\", () => pm.expect(body.retrieval).to.equal(\"als\"));"
                ]
              }
            }
          ]
        }
