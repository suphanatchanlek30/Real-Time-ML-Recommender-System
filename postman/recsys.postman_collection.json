{
  "info": {
    "name": "Recommender API",
    "description": "Test cases for the real-time recommender API. Send any request on its own, or run the whole collection with the Collection Runner (every request has tests and none depends on another).\n\nStart the system first (`make up` and `make replay`), then import this collection and the `local` environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health and metrics",
      "item": [
        {
          "name": "Health: model loaded and Redis reachable",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ],
              "query": []
            },
            "description": "Is the API up, which model is loaded and can it reach Redis. event_clock is the event time of the newest streamed event (null until `make replay` has run)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"status ok\", () => pm.expect(b.status).to.equal(\"ok\"));",
                  "pm.test(\"a model version is loaded\", () => pm.expect(b.model_version).to.be.a(\"string\").and.not.empty);",
                  "pm.test(\"Redis reachable\", () => pm.expect(b.redis).to.equal(true));",
                  "pm.test(\"model and feature snapshot are the same one\", () => pm.expect(b.snapshot_as_of).to.be.a(\"string\"));",
                  "pm.collectionVariables.set(\"model_version\", b.model_version);"
                ]
              }
            }
          ]
        },
        {
          "name": "Metrics: Prometheus text",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "metrics"
              ],
              "query": []
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.text();",
                  "pm.test(\"is Prometheus text\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/plain\"));",
                  "pm.test(\"has the latency histogram\", () => pm.expect(t).to.include(\"http_request_duration_seconds_bucket\"));",
                  "pm.test(\"has request counters\", () => pm.expect(t).to.include(\"http_requests_total\"));",
                  "pm.test(\"has the answer-source counter\", () => pm.expect(t).to.include(\"recommend_source_total\"));",
                  "pm.test(\"has the Redis error counter\", () => pm.expect(t).to.include(\"redis_errors_total\"));",
                  "pm.sendRequest(pm.variables.replaceIn(\"{{base_url}}/health\"), (err, res) => {",
                  "  pm.test(\"shows the loaded model version\", () => {",
                  "    pm.expect(err).to.equal(null);",
                  "    pm.expect(t).to.include(\"model_info{version=\\\"\" + res.json().model_version + \"\\\"}\");",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": ""
    },
    {
      "name": "2. Recommend",
      "item": [
        {
          "name": "Known user (ALS knows them), k=10",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/recommend?user_id={{known_user}}&k=10",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "recommend"
              ],
              "query": [
                {
                  "key": "user_id",
                  "value": "{{known_user}}"
                },
                {
                  "key": "k",
                  "value": "10"
                }
              ]
            },
            "description": "A user with enough history for ALS: candidates come from ALS, then the Ranker reorders them."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"has items, model_version, source, retrieval, degraded\", () => {",
                  "  pm.expect(body).to.have.all.keys(\"items\", \"model_version\", \"source\", \"retrieval\", \"degraded\");",
                  "});",
                  "pm.test(\"returns exactly 10 items\", () => pm.expect(body.items).to.have.lengthOf(10));",
                  "pm.test(\"every item has an integer item_id and a numeric score\", () => {",
                  "  body.items.forEach(i => { pm.expect(Number.isInteger(i.item_id)).to.be.true; pm.expect(i.score).to.be.a(\"number\"); });",
                  "});",
                  "pm.test(\"scores are sorted from best to worst\", () => {",
                  "  const s = body.items.map(i => i.score);",
                  "  for (let n = 1; n < s.length; n++) pm.expect(s[n - 1]).to.be.at.least(s[n]);",
                  "});",
                  "pm.test(\"no item is repeated\", () => {",
                  "  const ids = body.items.map(i => i.item_id);",
                  "  pm.expect(new Set(ids).size).to.equal(ids.length);",
                  "});",
                  "pm.test(\"source is ranker and Redis was reachable (not degraded)\", () => {",
                  "  pm.expect(body.source).to.equal(\"ranker\"); pm.expect(body.degraded).to.equal(false);",
                  "});",
                  "pm.test(\"X-Model-Version header equals model_version in the body\", () => {",
                  "  pm.expect(pm.response.headers.get(\"X-Model-Version\")).to.equal(body.model_version);",
                  "});",
                  "pm.test(\"candidates came from als\", () => pm.expect(body.retrieval).to.equal(\"als\"));",
                  "pm.test(\"answers in under 250 ms\", () => pm.expect(pm.response.responseTime).to.be.below(250));"
                ]
              }
            }
          ]
        },
