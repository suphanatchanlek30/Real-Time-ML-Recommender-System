# Settings of the project. Copy to `.env` (make env does it) and edit `.env`; it is not committed.
# The Python code reads this file on the Mac (src/env.py); Docker Compose reads it for the
# ${...} values in docker-compose.yml. Format: KEY=value, one per line, `#` starts a comment line.

# ---------- Ports published on the Mac ----------
API_PORT=8000
REDIS_PORT=6379
KAFKA_EXTERNAL_PORT=9094

# ---------- Docker images ----------
KAFKA_IMAGE=apache/kafka:3.9.0
REDIS_IMAGE=redis:7-alpine

# ---------- Redis (online feature store) ----------
REDIS_HOST=localhost
REDIS_DB=0
# seconds; a slower Redis makes the API answer without user features
REDIS_TIMEOUT_S=0.05

# ---------- Kafka (user events) ----------
KAFKA_TOPIC=user-events
KAFKA_GROUP=feature-updater
KAFKA_PARTITIONS=3
# events per second sent by `make replay`
KAFKA_REPLAY_RATE=2000

# ---------- Model and features ----------
# paths on the Mac, relative to the project folder
MODEL_DIR=models/champion
FEATURES_DIR=data/features
# which feature snapshot the API serves (must be the one the champion was trained on)
FEATURES_SNAPSHOT=val
# data folder of the ETL (raw/ and processed/)
DATA_DIR=data

# ---------- API ----------
# when set, POST /admin/reload needs the header  X-Admin-Token: <value>
ADMIN_TOKEN=

# ---------- MLflow ----------
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
